# Postgres (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
# SQLAlchemy URL for the main (owner) database
DATABASE_URL=postgresql://postgres:change-me@dbmp:5432/postgres

# Used only by app/fixtures/export_demo_candidates.py (read-only export of demo candidates)
PROD_DATABASE_URL=postgresql://user:password@prod-host:5432/dbname

# --- Auth (REQUIRED: the app refuses to start without these three) ---
# Random signing key for session cookies, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SESSION_SECRET=replace-with-random-hex
# Argon2 hash of the owner PIN (python -m app.auth.pin <pin>). It contains `$`: escape each as `$$` in a
# docker compose .env file; with `dokku config:set` single-quote the value.
OWNER_PIN_HASH=replace-with-argon2-hash
# Id of the owner row in the users table
OWNER_USER_ID=1
# Comma-separated allowed CORS origins (default http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
# Set the session cookie Secure flag; use false for plain-http local dev (default true)
COOKIE_SECURE=true

# --- Demo mode ---
# SQLite file serving anonymous demo visitors (default data/demo.sqlite)
DEMO_DB_PATH=data/demo.sqlite
# JSON seed used to build the demo DB (default app/demo/seed.json)
DEMO_SEED_PATH=app/demo/seed.json
# Dropbox folder for demo uploads (default /recipes-demo)
DROPBOX_DEMO_FOLDER=/recipes-demo

# --- Dropbox ---
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token
# Folder for owner recipe uploads (default /recipes)
DROPBOX_UPLOAD_FOLDER=/recipes

# --- AI providers ---
# Provider selector: google/gemini or openrouter (GEMINI_PROVIDER is a legacy alias)
AI_PROVIDER=openrouter
GOOGLE_AI_API_KEY=your-google-ai-key
# Override Gemini base URL (alias: GEMINI_API_URL)
GEMINI_API_BASE_URL=
OPENROUTER_API_KEY=your-openrouter-key
# Override OpenRouter base URL (alias: OPENROUTER_API_URL)
OPENROUTER_API_BASE_URL=
# Attribution headers sent to OpenRouter (aliases: OPENROUTER_HTTP_REFERER, OPENROUTER_SITE_NAME)
OPENROUTER_SITE_URL=
OPENROUTER_SITE_TITLE=
# Model overrides (alias for OPENROUTER_MODEL: OPENROUTER_DEFAULT_MODEL)
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# --- FoodData Central ---
# Local SQLite snapshot and synonyms file (defaults under data/)
FDC_SQLITE_PATH=data/fdc.sqlite
FDC_SYNONYMS_PATH=data/fdc_synonyms.json
